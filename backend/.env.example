# Server
PORT=4000

# Redis — BullMQ job queue backend
REDIS_URL=redis://localhost:6379

# Directory where finished ZIPs are stored
STORAGE_DIR=/tmp/downloads

# Max concurrent yt-dlp downloads within a single job (audio streams in parallel)
DOWNLOAD_CONCURRENCY=5

# Max concurrent jobs the BullMQ worker processes simultaneously
WORKER_CONCURRENCY=3
